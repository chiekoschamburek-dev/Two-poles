# 服务端默认模型（保底）。填在这里的密钥只留在服务端，不会进前端包。
# 真实部署时也可以用同名环境变量覆盖（环境变量优先）。
# 阿里云 ESA「函数和 Pages」：在函数的「函数变量」里填同名三项，API key 勾「加密存储」并勾生产环境；
# 构建环境变量只用于构建期，函数运行时读不到。不要把变量名加 VITE_ 前缀，那会被 Vite 打进浏览器 bundle。
# 饮食照片识别与计划生成共用这份模型配置；要做拍照识别，模型需支持 image_url 图片输入。
# 设置页里「使用我填的接口」也走同一份配置；不支持图片的模型会在识别时报错并提示改用本机。
LLM_DEFAULT_BASE_URL=
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=

# —— 账号与同步（可选）——
# 不配置时应用保持纯本机模式。本地开发：先 npm run server，再 npm run dev。
# same-origin 表示请求同源 /api/v1，由 Vite 代理到 127.0.0.1:8787。
VITE_API_BASE_URL=
# VITE_API_BASE_URL=same-origin
# 无需后端的开发契约 mock（仅 dev 生效）：
# VITE_API_MOCK=true

# 服务端（server/index.mjs）变量：
# PORT=8787
# HOST=127.0.0.1
# TWOPOLES_DB=./server/data/twopoles.sqlite
# AUTH_SECRET=replace-with-a-long-random-string
# COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
