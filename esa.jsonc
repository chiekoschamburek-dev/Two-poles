{
  "entry": "./apps/api/llm.js",
  "installCommand": "cd apps/web && npm install --include=dev",
  "buildCommand": "cd apps/web && npm install --include=dev && VITE_API_BASE_URL=same-origin npm run build",
  "assets": {
    "directory": "./apps/web/dist",
    "notFoundStrategy": "singlePageApplication"
  }
}